  <version>0.1.0</version>
  <description>Workflow tools for LI-Init LiDAR-IMU extrinsic calibration.</description>
  <maintainer email="mxw@todo.todo">mxw</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_srvs</depend>
  <depend>std_msgs</depend>
